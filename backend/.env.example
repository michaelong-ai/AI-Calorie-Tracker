# Template for backend/.env — COPY this file to `.env` (same folder) and
# fill in real values. `.env` is gitignored; this example file is committed.
# The server loads .env at startup (see app/main.py).

# Your Anthropic API key — get one at https://platform.claude.com
# Powers the meal-photo estimation and nutrition-label scanning.
# NEVER commit the real key, and never put it in frontend code.
ANTHROPIC_API_KEY=sk-ant-paste-your-key-here

# Optional: which Claude model to use for estimation.
# Default (if unset): claude-opus-4-8 — highest quality.
# ESTIMATE_MODEL=claude-opus-4-8

# --- Telegram bot (optional; only needed to log meals via Telegram) ---------
# Create a bot with @BotFather in Telegram (/newbot) and paste its token here.
# Without this, the web app works fully; only the bot (dev-bot.ps1) needs it.
# TELEGRAM_BOT_TOKEN=123456789:paste-your-bot-token-here
#
# The one chat the bot serves (yours). Leave it unset the first time — send
# the bot a message and it replies with your chat id to paste here, which
# locks the bot to you. Every other chat is then refused.
# TELEGRAM_CHAT_ID=
